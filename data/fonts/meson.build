# Typefaces used by the bundled Broadsheet theme (Death to the World voices).
# Installed under datadir/fonts/flaclify, which fontconfig scans by default for
# a ~/.local or /usr prefix. All OFL except Special Elite (Apache 2.0).
install_data(
  'PirataOne-Regular.ttf',
  'OldStandard-Regular.ttf',
  'OldStandard-Italic.ttf',
  'OldStandard-Bold.ttf',
  'SpecialElite-Regular.ttf',
  'LaBelleAurore.ttf',
  'IMFeENsc28P.ttf',
  install_dir: get_option('datadir') / 'fonts' / 'flaclify',
)
