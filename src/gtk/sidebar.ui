<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<requires lib="gtk" version="4.0" />
	<requires lib="Adw" version="1.0" />
	<template class="EuphonicaSidebar" parent="GtkBox">
		<child>
			<object class="GtkScrolledWindow">
				<property name="hscrollbar-policy">never</property>
				<property name="vexpand">true</property>
				<property name="child">
					<object class="GtkBox">
						<property name="orientation">1</property>
						<property name="spacing">6</property>
						<child>
							<object class="EuphonicaSidebarButton" id="recent_btn">
								<property name="label" translatable="true">Recent</property>
							</object>
						</child>
						<child>
							<object class="GtkSeparator"></object>
						</child>
						<child>
							<object class="EuphonicaSidebarButton" id="albums_btn">
								<property name="group">recent_btn</property>
								<property name="label" translatable="true">Albums</property>
							</object>
						</child>
						<child>
							<object class="EuphonicaSidebarButton" id="artists_btn">
								<property name="group">recent_btn</property>
								<property name="label" translatable="true">Artists</property>
							</object>
						</child>
						<child>
							<object class="EuphonicaSidebarButton" id="folders_btn">
								<property name="group">recent_btn</property>
								<property name="label" translatable="true">Folders</property>

							</object>
						</child>

						<child>
							<object class="GtkBox" id="dyn_playlists_section">
								<!-- TODO: only show when supported -->
								<property name="visible">true</property>
								<property name="spacing">6</property>
								<property name="orientation">1</property>
								<child>
									<object class="GtkSeparator"></object>
								</child>

								<child>
									<object class="EuphonicaSidebarButton" id="dyn_playlists_btn">
										<property name="group">recent_btn</property>
										<property name="label" translatable="true">Dynamic Playlists</property>
									</object>
								</child>

								<child>
									<object class="GtkListBox" id="recent_dyn_playlists">
										<property name="hexpand">true</property>
										<property name="selection-mode">none</property>
										<style>
											<class name="no-bg"/>
										</style>
									</object>
								</child>
							</object>
						</child>
						<child>
							<object class="GtkBox" id="playlists_section">
								<property name="visible">false</property>
								<property name="spacing">6</property>
								<property name="orientation">1</property>
								<child>
									<object class="GtkSeparator"></object>
								</child>

								<child>
									<object class="EuphonicaSidebarButton" id="playlists_btn">
										<property name="group">recent_btn</property>
										<property name="label" translatable="true">Saved Playlists</property>
									</object>
								</child>

								<child>
									<object class="GtkListBox" id="recent_playlists">
										<property name="hexpand">true</property>
										<property name="selection-mode">none</property>
										<style>
											<class name="no-bg"/>
										</style>
									</object>
								</child>
							</object>
						</child>

						<child>
							<!-- flacli's own pages (roadmap Tier 2): Get music by name, Tidy the library.
							     Shown only when flacli is on the PATH and files into the folder MPD serves. -->
							<object class="GtkBox" id="flacli_section">
								<property name="visible">false</property>
								<property name="orientation">1</property>
								<property name="spacing">6</property>
								<child>
									<object class="GtkSeparator"></object>
								</child>
								<child>
									<object class="EuphonicaSidebarButton" id="get_btn">
										<property name="group">recent_btn</property>
										<property name="label" translatable="true">Get</property>
									</object>
								</child>
								<child>
									<object class="EuphonicaSidebarButton" id="requests_btn">
										<property name="group">recent_btn</property>
										<property name="label" translatable="true">Requests</property>
									</object>
								</child>
								<child>
									<object class="EuphonicaSidebarButton" id="tidy_btn">
										<property name="group">recent_btn</property>
										<property name="label" translatable="true">Tidy</property>
									</object>
								</child>
								<child>
									<object class="EuphonicaSidebarButton" id="ask_btn">
										<property name="group">recent_btn</property>
										<property name="label" translatable="true">Ask flacli</property>
									</object>
								</child>
							</object>
						</child>
						<child>
							<!-- What flacli is fetching (roadmap Tier 1). Shown only when flacli is on the PATH,
							     files into the library MPD serves, and has a playlist under way or awaiting review. -->
							<object class="GtkBox" id="incoming_section">
								<property name="visible">false</property>
								<property name="spacing">6</property>
								<property name="orientation">1</property>
								<child>
									<object class="GtkSeparator"></object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="margin-start">12</property>
										<property name="margin-end">6</property>
										<child>
											<object class="GtkLabel">
												<property name="label" translatable="true">Incoming</property>
												<property name="hexpand">true</property>
												<property name="xalign">0</property>
												<style>
													<class name="caption-heading"/>
													<class name="dim-label"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkSpinner" id="incoming_spinner">
												<property name="visible">false</property>
												<property name="spinning">true</property>
												<property name="margin-end">6</property>
											</object>
										</child>
										<child>
											<object class="GtkButton" id="incoming_refresh">
												<property name="icon-name">view-refresh-symbolic</property>
												<property name="tooltip-text" translatable="true">Ask flacli again</property>
												<property name="valign">3</property>
												<style>
													<class name="flat"/>
													<class name="circular"/>
												</style>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkListBox" id="incoming_list">
										<property name="hexpand">true</property>
										<property name="selection-mode">none</property>
										<style>
											<class name="no-bg"/>
										</style>
									</object>
								</child>
							</object>
						</child>

						<child>
							<object class="GtkSeparator"></object>
						</child>

						<child>
							<object class="GtkToggleButton" id="queue_btn">
								<property name="group">recent_btn</property>
								<property name="child">
									<object class="GtkCenterBox">
										<property name="start-widget">
											<object class="GtkLabel">
												<property name="label">Queue</property>
											</object>
										</property>

										<property name="end-widget">
											<object class="GtkLabel" id="queue_len">
												<property name="label">0</property>
											</object>
										</property>
									</object>
								</property>
								<style>
									<class name="flat"/>
									<class name="queue-btn"/>
								</style>
							</object>
						</child>
					</object>
				</property>
			</object>
		</child>
		<style>
			<class name="flaclify-sidebar"/>
		</style>
	</template>
</interface>
