<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.4"/>
  <template class="EuphonicaOnboardingWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="true">Welcome to Flaclify</property>
    <property name="default-width">560</property>
    <property name="default-height">720</property>
    <property name="height-request">600</property>
    <property name="width-request">360</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 500sp</condition>
        <setter object="release_folder_1_image" property="pixel-size">72</setter>
        <setter object="release_folder_2_image" property="pixel-size">72</setter>
        <setter object="mixed_folder_1_image" property="pixel-size">72</setter>
        <setter object="mixed_folder_2_image" property="pixel-size">72</setter>
      </object>
    </child>

    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <child>
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-title">false</property>
                <child type="start">
                  <object class="GtkButton" id="back_btn">
                    <property name="icon-name">go-previous-symbolic</property>
                    <property name="tooltip-text" translatable="true">Back</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="AdwCarousel" id="carousel">
                <property name="hexpand">true</property>
                <property name="interactive">false</property>
                <property name="allow-scroll-wheel">false</property>
                <property name="allow-long-swipes">false</property>
                <property name="vexpand">true</property>

                <!-- 1 · Welcome -->
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">520</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="valign">center</property>
                            <property name="spacing">12</property>
                            <style><class name="padding-12"/></style>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">io.github.h3303.Flaclify</property>
                                <property name="pixel-size">128</property>
                                <property name="margin-bottom">12</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Welcome to Flaclify</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="title-1"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">A player for the music kept on this computer. It reads the folders you point it at, shows each album with its cover and each artist with a bio, and can fetch what is missing by name.</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="body"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Four short steps, then the player. Everything here can be changed later in Preferences.</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="dim-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 2 · Where is the music -->
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">560</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="spacing">12</property>
                            <style><class name="padding-12"/></style>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Where is your music?</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="title-2"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Flaclify plays through a Music Player Daemon. It can run one of its own on a folder of yours, which is the right choice unless you already keep one running.</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="dim-label"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox">
                                <property name="selection-mode">0</property>
                                <property name="margin-top">6</property>
                                <style><class name="boxed-list"/></style>
                                <child>
                                  <object class="AdwActionRow" id="music_dir_row">
                                    <property name="title" translatable="true">Music folder</property>
                                    <property name="subtitle">~/Music</property>
                                    <property name="subtitle-selectable">true</property>
                                    <property name="activatable-widget">music_dir_btn</property>
                                    <child type="suffix">
                                      <object class="GtkButton" id="music_dir_btn">
                                        <property name="valign">center</property>
                                        <property name="label" translatable="true">Change…</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="managed_status_row">
                                    <property name="title" translatable="true">Built-in player</property>
                                    <property name="subtitle" translatable="true">Checking…</property>
                                    <child type="prefix">
                                      <object class="GtkImage" id="managed_status_icon">
                                        <property name="icon-name">fl-content-loading-symbolic</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox">
                                <property name="selection-mode">0</property>
                                <property name="margin-top">6</property>
                                <style><class name="boxed-list"/></style>
                                <child>
                                  <object class="AdwExpanderRow" id="own_mpd_row">
                                    <property name="title" translatable="true">I already run a Music Player Daemon</property>
                                    <property name="subtitle" translatable="true">Connect to it instead of starting one.</property>
                                    <property name="show-enable-switch">true</property>
                                    <property name="enable-expansion">false</property>
                                    <child>
                                      <object class="AdwSwitchRow" id="own_use_unix_socket">
                                        <property name="title" translatable="true">Connect via local socket</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwEntryRow" id="own_unix_socket">
                                        <property name="title" translatable="true">Local socket</property>
                                        <property name="visible">false</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwEntryRow" id="own_host">
                                        <property name="title" translatable="true">Host address</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwEntryRow" id="own_port">
                                        <property name="title" translatable="true">Port</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 3 · Library layout (upstream's page, kept) -->
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">560</property>
                        <child>
                          <object class="GtkBox">
                            <style><class name="padding-12"/></style>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">How is your library organised?</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="title-2"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="homogeneous">true</property>
                                <property name="spacing">12</property>
                                <property name="margin-top">12</property>
                                <child>
                                  <object class="GtkButton" id="release_folder_library_button">
                                    <property name="hexpand">true</property>
                                    <property name="vexpand">false</property>
                                    <accessibility>
                                      <property name="label" translatable="true">Each album/release has its own folder</property>
                                    </accessibility>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="AdwWrapBox">
                                            <property name="align">0.5</property>
                                            <property name="child-spacing">24</property>
                                            <property name="line-spacing">24</property>
                                            <property name="margin-top">18</property>
                                            <property name="margin-bottom">18</property>
                                            <child>
                                              <object class="GtkImage" id="release_folder_1_image">
                                                <property name="icon-name">release-folder-1-symbolic</property>
                                                <property name="pixel-size">96</property>
                                                <style><class name="accent"/></style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkImage" id="release_folder_2_image">
                                                <property name="icon-name">release-folder-2-symbolic</property>
                                                <property name="pixel-size">96</property>
                                                <style><class name="accent"/></style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="true">Each album/release has its own folder</property>
                                            <property name="wrap">true</property>
                                            <property name="justify">center</property>
                                            <property name="margin-start">6</property>
                                            <property name="margin-end">6</property>
                                            <property name="vexpand">true</property>
                                            <property name="valign">center</property>
                                            <style><class name="heading"/></style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkCheckButton" id="release_folder_library_mode">
                                            <property name="halign">center</property>
                                            <property name="margin-bottom">6</property>
                                            <accessibility>
                                              <property name="label" translatable="true">Each album/release has its own folder</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="mixed_library_button">
                                    <property name="hexpand">true</property>
                                    <property name="vexpand">false</property>
                                    <accessibility>
                                      <property name="label" translatable="true">Other/mixed</property>
                                    </accessibility>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="AdwWrapBox">
                                            <property name="align">0.5</property>
                                            <property name="child-spacing">24</property>
                                            <property name="line-spacing">24</property>
                                            <property name="margin-top">18</property>
                                            <property name="margin-bottom">18</property>
                                            <child>
                                              <object class="GtkImage" id="mixed_folder_1_image">
                                                <property name="icon-name">mixed-folder-1-symbolic</property>
                                                <property name="pixel-size">96</property>
                                                <style><class name="accent"/></style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkImage" id="mixed_folder_2_image">
                                                <property name="icon-name">mixed-folder-2-symbolic</property>
                                                <property name="pixel-size">96</property>
                                                <style><class name="accent"/></style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="true">Other/mixed</property>
                                            <property name="wrap">true</property>
                                            <property name="justify">center</property>
                                            <property name="margin-start">6</property>
                                            <property name="margin-end">6</property>
                                            <property name="vexpand">true</property>
                                            <property name="valign">center</property>
                                            <style><class name="heading"/></style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkCheckButton" id="mixed_library_mode">
                                            <property name="group">release_folder_library_mode</property>
                                            <property name="halign">center</property>
                                            <property name="margin-bottom">6</property>
                                            <accessibility>
                                              <property name="label" translatable="true">Other/mixed</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox">
                                <property name="selection-mode">0</property>
                                <property name="margin-top">12</property>
                                <style><class name="boxed-list"/></style>
                                <child>
                                  <object class="AdwExpanderRow">
                                    <property name="title" translatable="true">Why does this matter?</property>
                                    <property name="expanded">false</property>
                                    <child>
                                      <object class="GtkListBoxRow">
                                        <property name="selectable">false</property>
                                        <property name="activatable">false</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="true">Knowing the folder layout lets Flaclify optimise cover art loading.&#10;&#10;If every folder contains tracks from only one release, Flaclify loads its cover art once and applies it to all tracks. It first checks for &lt;tt&gt;cover.png&lt;/tt&gt;, &lt;tt&gt;cover.webp&lt;/tt&gt;, or &lt;tt&gt;cover.jpg&lt;/tt&gt;, then uses the first embedded image it finds.&#10;&#10;If a folder contains multiple releases, shared cover art could be applied to the wrong tracks. Choose &lt;b&gt;Other/mixed&lt;/b&gt; for these libraries. Cover files still take priority; without one, Flaclify loads embedded art per track.&#10;&#10;For single-release folders, add a cover file to avoid duplicate downloads. For mixed folders, remove it to use per-track embedded art.</property>
                                            <property name="use-markup">true</property>
                                            <property name="wrap">true</property>
                                            <property name="xalign">0</property>
                                            <style><class name="padding-12"/></style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 4 · flacli, optional -->
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">560</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="spacing">12</property>
                            <style><class name="padding-12"/></style>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Music by name, optional</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="title-2"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">With flacli beside it, Flaclify can fetch a song, an album or a whole playlist you name, file it as Artist/Album/Track next to your music, and fill in the covers, bios and wikis. flacli is a separate command line that uses your own Nicotine+ (Soulseek) client. Without it the player works as a player.</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="dim-label"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox">
                                <property name="selection-mode">0</property>
                                <property name="margin-top">6</property>
                                <style><class name="boxed-list"/></style>
                                <child>
                                  <object class="AdwActionRow" id="flacli_status_row">
                                    <property name="title" translatable="true">flacli</property>
                                    <property name="subtitle" translatable="true">Looking…</property>
                                    <property name="subtitle-lines">4</property>
                                    <child type="prefix">
                                      <object class="GtkImage" id="flacli_status_icon">
                                        <property name="icon-name">fl-content-loading-symbolic</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="nicotine_status_row">
                                    <property name="title" translatable="true">Nicotine+ bridge</property>
                                    <property name="subtitle" translatable="true">Looking…</property>
                                    <property name="subtitle-lines">4</property>
                                    <child type="prefix">
                                      <object class="GtkImage" id="nicotine_status_icon">
                                        <property name="icon-name">fl-content-loading-symbolic</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwButtonRow" id="flacli_guide_btn">
                                    <property name="title" translatable="true">Open the setup guide</property>
                                    <property name="start-icon-name">globe-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwButtonRow" id="flacli_recheck_btn">
                                    <property name="title" translatable="true">Check again</property>
                                    <property name="start-icon-name">fl-view-refresh-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">Skip this and the player is a player. Set it up any time later: the verdict lives under Preferences → Integrations → flacli.</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="dim-label"/><class name="caption"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 5 · Ready -->
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">560</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <property name="spacing">12</property>
                            <property name="valign">center</property>
                            <style><class name="padding-12"/></style>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">That is everything</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="title-2"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="true">The first scan of a large library takes a minute; albums appear as it goes. A few places worth knowing:</property>
                                <property name="wrap">true</property>
                                <property name="justify">center</property>
                                <style><class name="dim-label"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox">
                                <property name="selection-mode">0</property>
                                <property name="margin-top">6</property>
                                <style><class name="boxed-list"/></style>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="true">The sidebar</property>
                                    <property name="subtitle" translatable="true">Recent, Albums, Artists, Folders, Playlists and the Queue. Ctrl+1 to Ctrl+7 jump between them.</property>
                                    <property name="subtitle-lines">3</property>
                                    <child type="prefix"><object class="GtkImage"><property name="icon-name">library-symbolic</property></object></child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="true">Themes</property>
                                    <property name="subtitle" translatable="true">Eleven looks under the main menu; Ctrl+T cycles them while the music plays.</property>
                                    <property name="subtitle-lines">3</property>
                                    <child type="prefix"><object class="GtkImage"><property name="icon-name">brush-symbolic</property></object></child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="ready_get_row">
                                    <property name="title" translatable="true">Get, Requests, Tidy, Ask flacli</property>
                                    <property name="subtitle" translatable="true">Below Folders in the sidebar once flacli is set up: search MusicBrainz and tick what you want, follow what is on its way, tidy the library, or type a sentence.</property>
                                    <property name="subtitle-lines">4</property>
                                    <child type="prefix"><object class="GtkImage"><property name="icon-name">fl-edit-find-symbolic</property></object></child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="true">Preferences</property>
                                    <property name="subtitle" translatable="true">The player, the folder it serves, the integrations and the visualiser, all under the main menu.</property>
                                    <property name="subtitle-lines">3</property>
                                    <child type="prefix"><object class="GtkImage"><property name="icon-name">settings-symbolic</property></object></child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>

            <child type="bottom">
              <object class="GtkBox">
                <property name="orientation">1</property>
                <property name="spacing">6</property>
                <style><class name="padding-12"/></style>
                <child>
                  <object class="AdwCarouselIndicatorDots">
                    <property name="carousel">carousel</property>
                    <property name="halign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="next_btn">
                    <property name="halign">center</property>
                    <property name="width-request">220</property>
                    <property name="label" translatable="true">Continue</property>
                    <style>
                      <class name="pill"/>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
